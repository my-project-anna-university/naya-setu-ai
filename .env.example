# NyayaSetu Environment Variables Example
# Duplicate this file as .env in the root or in the respective server/client directories

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/nyayasetu

# Authentication & Security
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d

# Free AI Agent Providers (100% Free Tiers)
GROQ_API_KEY=optional-groq-key-from-console.groq.com
GEMINI_API_KEY=optional-gemini-key-from-aistudio.google.com
OPENROUTER_API_KEY=optional-openrouter-key-from-openrouter.ai
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434

# Client Configuration (for React / Vite)
CLIENT_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000/api
